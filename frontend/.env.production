# Production Configuration for ClipStream
# Frontend deployed at: clipstream.finailabz.com  
# Backend deployed at: backend.finailabz.com

# Backend API Configuration - Production
VITE_API_BASE_URL=https://clipstream-backend.finailabz.com

# Backend and Frontend base URLs (used for OAuth redirect construction)
BACKEND_BASE_URL=https://clipstream-backend.finailabz.com
FRONTEND_BASE_URL=https://clipstream.finailabz.com

# OAuth Provider Credentials - set these securely in your production environment
# Google (OpenID Connect)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Facebook
FACEBOOK_CLIENT_ID=your-facebook-client-id
FACEBOOK_CLIENT_SECRET=your-facebook-client-secret

# Apple (optional)
APPLE_CLIENT_ID=your-apple-client-id
APPLE_CLIENT_SECRET=your-apple-client-secret

# Twitter (optional)
TWITTER_CLIENT_ID=your-twitter-client-id
TWITTER_CLIENT_SECRET=your-twitter-client-secret

# Supabase Configuration (optional - not used in development)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key