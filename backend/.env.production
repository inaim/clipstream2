# Production Environment with REAL Videos

# Use PRODUCTION videos (real playable URLs, not random demo)
INGEST_DEMO_VIDEOS=false
ENVIRONMENT=development

# Database
SURREALDB_URL=ws://localhost:8000/rpc
SURREALDB_USER=root
SURREALDB_PASS=root
SURREALDB_NS=clipstream
SURREALDB_DB=production

# Redis for events
REDIS_URL=redis://localhost:6379/0

# ML Features
ENABLE_AI_PROCESSING=true
ENABLE_TOKEN_REWARDS=true
