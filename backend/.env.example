# Application Settings
APP_NAME=ClipStream
APP_ENV=development
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Server Configuration
HOST=0.0.0.0
PORT=8001
WORKERS=4

# Database - SurrealDB
SURREALDB_URL=http://localhost:8000
SURREALDB_USER=root
SURREALDB_PASS=root
SURREALDB_NS=clipstream
SURREALDB_DB=main

# Cache - Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50
CACHE_TTL=3600

# IPFS Configuration
IPFS_API_URL=http://localhost:5001
IPFS_GATEWAY_URL=http://localhost:8080
IPFS_PIN_ENABLED=True

# Filecoin Configuration (optional)
FILECOIN_ENABLED=False
FILECOIN_API_URL=https://api.filecoin.io
FILECOIN_TOKEN=your-filecoin-token

# Blockchain - Polygon
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_CHAIN_ID=137
WATCH_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
PRIVATE_KEY=your-private-key-here

# AI Services
OPENAI_API_KEY=your-openai-api-key
WHISPER_MODEL=base
CLIP_MODEL=ViT-B/32

# Content Moderation
MODERATION_ENABLED=True
NSFW_THRESHOLD=0.7
VIOLENCE_THRESHOLD=0.8
TOXICITY_THRESHOLD=0.6

# Video Processing
MAX_VIDEO_SIZE_MB=500
MAX_VIDEO_DURATION_SECONDS=180
SUPPORTED_FORMATS=mp4,mov,avi,webm
VIDEO_QUALITIES=360,480,720,1080
THUMBNAIL_COUNT=3

# Upload Configuration
UPLOAD_DIR=./uploads
TEMP_DIR=./temp
MAX_UPLOAD_SIZE_MB=500

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TIMEZONE=UTC
CELERY_ENABLE_UTC=True

# Celery Worker Settings
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_ACKS_LATE=True
CELERY_TASK_REJECT_ON_WORKER_LOST=True

# Celery Beat Schedule
CELERY_BEAT_SCHEDULE_ENABLED=True
VIRALITY_UPDATE_INTERVAL_MINUTES=5
TOKEN_SETTLEMENT_INTERVAL_HOURS=24

# Email Configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@clipstream.io

# AWS S3 (optional - for CDN storage)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=clipstream-videos

# Monitoring & Logging
LOG_LEVEL=INFO
SENTRY_DSN=your-sentry-dsn
SENTRY_ENVIRONMENT=development

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# CORS Settings
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_CREDENTIALS=True

# Feature Flags
ENABLE_GIFTS=True
ENABLE_COMMENTS=True
ENABLE_LIVE_STREAMING=False
ENABLE_NFT_MINTING=False

