# TikTok Auto-Ingestion Configuration
# Copy this to your .env file to configure TikTok video scraping

# ============================================
# AUTO-START CONFIGURATION
# ============================================

# Enable TikTok auto-ingestion on app startup (default: true)
ENABLE_TIKTOK_AUTO_INGEST=true

# ============================================
# SCRAPING CONFIGURATION
# ============================================

# These are configured in the service itself (backend/app/tiktok_auto_ingestion.py)
# You can also configure via API after startup:
# POST /api/v1/tiktok-ingestion/start
# {
#   "use_browser": true,
#   "fetch_interval": 300,
#   "videos_per_fetch": 20
# }

# Default values:
# - use_browser: true (uses Playwright headless browser)
# - fetch_interval: 300 seconds (5 minutes)
# - videos_per_fetch: 10 videos per cycle

# ============================================
# TRENDING HASHTAGS
# ============================================

# Hashtags to scrape (configured in backend/app/tiktok_auto_ingestion.py):
# TRENDING_HASHTAGS = [
#     "fyp", "foryou", "viral", "trending",
#     "funny", "comedy", "sports", "music",
#     "gaming", "dance", "cooking", "travel"
# ]

# ============================================
# REQUIREMENTS
# ============================================

# Before starting, make sure you have:
# 1. pip install playwright yt-dlp
# 2. playwright install chromium
#
# To verify installation:
# python -c "from playwright.sync_api import sync_playwright; print('Playwright OK')"

# ============================================
# USAGE
# ============================================

# The service will automatically start when the app starts.
# You'll see this in the logs:
#
# [STEP 3.5] Starting TikTok auto-ingestion with browser scraping...
# ✅ TikTok auto-ingestion service started (browser scraping enabled)
#    - Scraping trending hashtags every 5 minutes
#    - Browser: Headless Chromium with infinite scroll
#    - Sources: #fyp, #viral, #trending, etc.

# ============================================
# CONTROL VIA API
# ============================================

# Check status:
# curl http://localhost:8080/api/v1/tiktok-ingestion/status | jq

# Stop service:
# curl -X POST http://localhost:8080/api/v1/tiktok-ingestion/stop | jq

# Start service with custom config:
# curl -X POST http://localhost:8080/api/v1/tiktok-ingestion/start \
#   -H "Content-Type: application/json" \
#   -d '{"use_browser": true, "videos_per_fetch": 20}' | jq

# Trigger manual ingestion now:
# curl -X POST http://localhost:8080/api/v1/tiktok-ingestion/trigger-now | jq

# ============================================
# DISABLE AUTO-START
# ============================================

# To disable auto-start on app launch:
# ENABLE_TIKTOK_AUTO_INGEST=false

# You can then start manually via API:
# curl -X POST http://localhost:8080/api/v1/tiktok-ingestion/start | jq
